<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FunctionPlotter.WinUI</RootNamespace>
    <AssemblyName>FunctionPlotter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- WinUI 3（Windows App SDK）—— 非打包应用，双击 exe 即可运行 -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <Platforms>x64;ARM64</Platforms>
    <!-- 未显式指定平台时默认 x64，避免 AnyCPU 触发 Windows App SDK 的架构检查 -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FunctionPlotter.Core\FunctionPlotter.Core.csproj" />
  </ItemGroup>

</Project>
