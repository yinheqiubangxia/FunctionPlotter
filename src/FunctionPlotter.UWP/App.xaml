<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FunctionPlotter.UWP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E4E4" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#616161" />
                    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#8A8A8A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#353535" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#8C8C8C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
