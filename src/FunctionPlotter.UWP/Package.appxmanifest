<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity
    Name="FunctionPlotter.UWP"
    Publisher="CN=FunctionPlotter"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="8f3b2c1d-4e5a-4b6c-9d7e-2f1a3b4c5d6e" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>函数绘图器</DisplayName>
    <PublisherDisplayName>FunctionPlotter</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="FunctionPlotter.UWP.App">
      <uap:VisualElements
        DisplayName="函数绘图器"
        Description="输入一个关于 x 的表达式，立刻画出曲线"
        BackgroundColor="#0F6CBD"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0F6CBD" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
